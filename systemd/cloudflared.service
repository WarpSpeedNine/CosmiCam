[Unit]
Description=cloudflared
After=network-online.target
Wants=network-online.target

[Service]
User=cloudflared
Group=cloudflared

Type=notify
ExecStart=/usr/bin/cloudflared --no-autoupdate --config /etc/cloudflared/config.yml tunnel run

Restart=on-failure
RestartSec=5s
TimeoutStartSec=15

[Install]
WantedBy=multi-user.target
